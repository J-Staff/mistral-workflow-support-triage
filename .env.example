# Support Triage — example environment file.
#
# Copy this file to `.env` and fill in your real values:
#     cp .env.example .env
#
# `.env` is gitignored, so your real key never lands in version control.


# Required. Your Mistral API key.
# Create one at https://console.mistral.ai/ inside a workspace that has
# Mistral Workflows + Devstral enabled.
MISTRAL_API_KEY=

# Optional. Mistral API endpoint. Defaults to the public hosted endpoint.
SERVER_URL=https://api.mistral.ai

# Optional. A short, human-readable name for this worker host. Shows up in
# AI Studio so you can tell multiple workers apart (e.g. "laptop", "prod-vm",
# "ci-runner"). Defaults to "default" if unset.
DEPLOYMENT_NAME=local
